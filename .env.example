# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# En producción: postgres://usuario:clave@host:5432/base
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=

# ---------- Tienda ----------
# Dirección pública del frontend (a ella vuelve el cliente después de pagar).
FRONTEND_URL=http://localhost:5173
# Costo de envío fijo en pesos.
SHOP_SHIPPING_COP=0
# Wompi: panel de comercios > Desarrolladores. Empieza con las llaves de pruebas.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
